<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    bootstrap="tests/unit/bootstrap.php"
    colors="true"
    cacheResult="false"
    beStrictAboutOutputDuringTests="true"
>
    <testsuites>
        <testsuite name="UNQVerify Unit Tests">
            <directory>tests/unit</directory>
        </testsuite>
    </testsuites>
</phpunit>