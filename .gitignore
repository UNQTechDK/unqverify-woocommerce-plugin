# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Agent skills
.agents/
skills-lock.json

# Local dev environment
.wp-env.json

# Test cache
.phpunit.result.cache

# PHP dependencies (reproducible via composer install)
/vendor/
composer.lock

# Node dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
pnpm-lock.yaml
package.json

# PHPUnit config (local dev only — WP.org reviewers don't need it)
phpunit.xml.dist

# Build scripts (local dev only)
/scripts/
/.build/

# Test results
/coverage

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# clerk configuration (can include secrets)
/.clerk/

certificates