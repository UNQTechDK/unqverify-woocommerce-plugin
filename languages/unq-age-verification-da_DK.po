# ── Variation inventory fields ──────────────────────────────────────────────

msgid "Require age verification for this variation"
msgstr "Kræv aldersverificering for denne variant"

msgid "This variation is already covered by a parent product or category rule. A direct rule is additive and can set its own age."
msgstr "Denne variant er allerede omfattet af en regel på moderproduktet eller kategorien. En direkte regel er supplerende og kan angive sin egen alder."

msgid "This variation has no inherited age-verification rule."
msgstr "Denne variant har ingen nedarvet regel for aldersverificering."

msgid "Leave empty to inherit the parent, category, or store age."
msgstr "Lad feltet være tomt for at arve alder fra moderproduktet, kategorien eller butikken."

msgid "Variation rules active"
msgstr "Variantregler er aktive"

#, php-format
msgid "%d variation has a direct age-verification rule."
msgid_plural "%d variations have direct age-verification rules."
msgstr[0] "%d variant har en direkte regel for aldersverificering."
msgstr[1] "%d varianter har direkte regler for aldersverificering."

msgid "They add to parent and category rules. A variation age override takes precedence only for that variation."
msgstr "De supplerer regler på moderproduktet og kategorien. En aldersoverstyring på en variant har kun forrang for den pågældende variant."

# ── Settings tab ─────────────────────────────────────────────────────────────

msgid "Aldersverificering"
msgstr "Aldersverificering"

# ── Status bar ───────────────────────────────────────────────────────────────

msgid "⚠ Disabled — no active key"
msgstr "⚠ Deaktiveret — ingen aktiv nøgle"

msgid "✅ Production — live verification active"
msgstr "✅ Produktion — live verificering aktiv"

msgid "🧪 Test mode — verifications are simulated"
msgstr "🧪 Testtilstand — verifikationer er simulerede"

msgid "Age verification is active on checkout"
msgstr "Aldersverificering er aktiv ved kassen"

msgid "Age verification is currently disabled"
msgstr "Aldersverificering er i øjeblikket deaktiveret"

# ── Environment & API Keys card ───────────────────────────────────────────────

msgid "Environment &amp; API Keys"
msgstr "Miljø &amp; API-nøgler"

msgid "Choose which environment is active, then enter the matching API key. Use Test mode first to verify the integration before going live."
msgstr "Vælg hvilket miljø der er aktivt, og angiv den tilsvarende API-nøgle. Brug Testtilstand først for at verificere integrationen inden du går live."

msgid "Test"
msgstr "Test"

msgid "Production"
msgstr "Produktion"

msgid "Test Public Key"
msgstr "Test Public Key"

msgid "Starts with pk_test_ — safe for development and staging."
msgstr "Starter med pk_test_ — sikker til udvikling og staging."

msgid "→ Get test key"
msgstr "→ Hent testnøgle"

msgid "Production Public Key"
msgstr "Produktions Public Key"

msgid "Starts with pk_live_ — enables real MitID verification."
msgstr "Starter med pk_live_ — aktiverer rigtig MitID-verificering."

msgid "→ Get production key"
msgstr "→ Hent produktionsnøgle"

# ── General Settings card ─────────────────────────────────────────────────────

msgid "General Settings"
msgstr "Generelle indstillinger"

msgid "Enable"
msgstr "Aktivér"

msgid "Enable age verification on checkout"
msgstr "Aktivér aldersverificering ved kassen"

msgid "Required Age"
msgstr "Påkrævet alder"

msgid "Minimum age (in years) a customer must have verified to complete a purchase."
msgstr "Minimumsalder (i år) som en kunde skal have verificeret for at gennemføre et køb."

msgid "Verification Mode"
msgstr "Verifikationstilstand"

msgid "Popup keeps customers on your page. Use redirect if popups are frequently blocked on your audience's devices."
msgstr "Popup holder kunderne på din side. Brug redirect hvis popups ofte blokeres på dit publikums enheder."

msgid "Popup (recommended)"
msgstr "Popup (anbefalet)"

msgid "Full-page redirect"
msgstr "Fuld-side redirect"

msgid "Popup Language"
msgstr "Popup-sprog"

msgid "Language shown to customers in the age verification popup and notices."
msgstr "Sprog vist til kunder i aldersverificerings-popup og beskeder."

msgid "Auto-detect (uses WordPress site language)"
msgstr "Auto-detektering (bruger WordPress-sproget)"

msgid "English"
msgstr "Engelsk"

msgid "Dansk"
msgstr "Dansk"

# ── Domain Setup card ─────────────────────────────────────────────────────────

msgid "Domain Setup"
msgstr "Domæneopsætning"

msgid "Required before going live:"
msgstr "Påkrævet inden du går live:"

msgid "You must add this site's domain to your whitelist at aldersverificering.dk before age verification will work. Without this step, all verification attempts will be rejected."
msgstr "Du skal tilføje dette sites domæne til din hvidliste på aldersverificering.dk, inden aldersverificering vil fungere. Uden dette trin vil alle verificeringsforsøg blive afvist."

msgid "Add the domain exactly as it appears in your store's URL. For this site that will be: %s"
msgstr "Tilføj domænet præcis som det vises i din butiks URL. For dette site vil det være: %s"

msgid "Configure Domains"
msgstr "Konfigurér domæner"

# ── Save button ───────────────────────────────────────────────────────────────

msgid "Save Settings"
msgstr "Gem indstillinger"

# ── Onboarding guide ──────────────────────────────────────────────────────────

msgid "Quick Start Guide"
msgstr "Hurtig startguide"

msgid "Follow these steps to set up and go live with age verification."
msgstr "Følg disse trin for at opsætte og gå live med aldersverificering."

msgid "Hide guide"
msgstr "Skjul guide"

msgid "Show guide"
msgstr "Vis guide"

msgid "Create your account"
msgstr "Opret din konto"

msgid "Sign up at aldersverificering.dk to get access to your API keys and domain settings."
msgstr "Opret en konto på aldersverificering.dk for at få adgang til dine API-nøgler og domæneindstillinger."

msgid "Create account"
msgstr "Opret konto"

msgid "Get your test key"
msgstr "Hent din testnøgle"

msgid "Copy your Test Public Key (starts with pk_test_) from your account. Paste it into the Test Public Key field above."
msgstr "Kopiér din Test Public Key (starter med pk_test_) fra din konto. Indsæt den i Test Public Key-feltet ovenfor."

msgid "Get API keys"
msgstr "Hent API-nøgler"

msgid "Configure your domain"
msgstr "Konfigurér dit domæne"

msgid "Add %s to the domain whitelist. Without this, verification will always fail."
msgstr "Tilføj %s til domænehvidlisten. Uden dette vil verificering altid mislykkes."

msgid "Configure domains"
msgstr "Konfigurér domæner"

msgid "Test the age gate"
msgstr "Test aldersporten"

msgid "Make sure Test mode is selected above and the plugin is enabled. Open a product page, add to cart, and attempt checkout — the age verification popup should appear."
msgstr "Sørg for at Testtilstand er valgt ovenfor og at pluginnet er aktiveret. Åbn en produktside, tilføj til kurv, og forsøg at gå til kassen — aldersverificerings-popup'en bør vises."

msgid "Go live"
msgstr "Gå live"

msgid "When testing looks good, upgrade your account, add your Production Public Key (pk_live_), and switch the environment toggle to Production."
msgstr "Når testen ser god ud, opgradering din konto, tilføj din Produktions Public Key (pk_live_), og skift miljøtoggle til Produktion."

msgid "Upgrade account"
msgstr "Opgrader konto"

msgid "🚀 Ready to go live?"
msgstr "🚀 Klar til at gå live?"

msgid "When you're ready for real age verification:"
msgstr "Når du er klar til rigtig aldersverificering:"

msgid "Get your Production Public Key (starts with pk_live_) from your account page."
msgstr "Hent din Produktions Public Key (starter med pk_live_) fra din kontoside."

msgid "Paste it into the Production Public Key field above and save."
msgstr "Indsæt den i Produktions Public Key-feltet ovenfor og gem."

msgid "Switch the environment toggle to Production and save again."
msgstr "Skift miljøtoggle til Produktion og gem igen."

msgid "Manage subscription"
msgstr "Administrér abonnement"

# ── Inline key validation (JS-side strings, output via wp_json_encode) ────────

msgid "must start with"
msgstr "skal starte med"

msgid "appears too short — please check your key"
msgstr "ser for kort ud — tjek venligst din nøgle"

# ── Save validation errors ────────────────────────────────────────────────────

msgid "Test key must start with pk_test_"
msgstr "Testnøgle skal starte med pk_test_"

msgid "Production key must start with pk_live_"
msgstr "Produktionsnøgle skal starte med pk_live_"

msgid "You cannot enable Production mode without a Production Public Key. Please add a pk_live_ key or switch back to Test mode."
msgstr "Du kan ikke aktivere Produktionstilstand uden en Produktions Public Key. Du skal tilføje en pk_live_-nøgle eller skifte tilbage til Testtilstand."

msgid "Security check failed."
msgstr "Sikkerhedstjek mislykkedes."

# ── Admin notice ──────────────────────────────────────────────────────────────

msgid "<strong>Aldersverificering:</strong> Ingen API-nøgle er konfigureret. <a href=\"%s\">Tilføj din nøgle under WooCommerce &rarr; Indstillinger &rarr; Aldersverificering</a>."
msgstr "<strong>Aldersverificering:</strong> Ingen API-nøgle er konfigureret. <a href=\"%s\">Tilføj din nøgle under WooCommerce &rarr; Indstillinger &rarr; Aldersverificering</a>."

# ── Callback page error ───────────────────────────────────────────────────────

msgid "Age verification is not configured."
msgstr "Aldersverificering er ikke konfigureret."
